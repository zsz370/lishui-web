# Server-side configuration only. Do not prefix secrets with VITE_.
# Local values: config/integrations.env.local (ignored by Git).
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com
QWEATHER_API_KEY=
QWEATHER_API_HOST=
AMAP_WEB_SERVICE_KEY=
BAIDU_TRANSLATE_APP_ID=
BAIDU_TRANSLATE_SECRET=
API_PORT=8787
# Explicit HTTPS origins when an isolated test deployment is authorized.
# Local defaults apply when omitted. Never use '*'.
# API_ALLOWED_ORIGINS=https://lsguide.cn
API_RATE_LIMIT=20
API_MAX_INFLIGHT=4
API_CHAT_TIMEOUT_MS=90000
# Enable only behind a loopback gateway that overwrites X-Real-IP.
API_TRUST_LOOPBACK_PROXY=false
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.5-4B
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
STAY_PROVIDER=fliggy
STAY_API_BASE_URL=https://flyai.open.fliggy.com/mcp
STAY_API_KEY=
