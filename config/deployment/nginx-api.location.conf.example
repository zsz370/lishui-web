# Local preparation only. NOT installed on the existing server.
# Future isolated test vhost: retain its existing SSL, Cloudflare rules and root.
# Verify gateway real-IP handling before enabling API_TRUST_LOOPBACK_PROXY.
location /api/ {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 110s;
    proxy_send_timeout 110s;
    client_max_body_size 24k;
}
